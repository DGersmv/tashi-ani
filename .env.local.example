# Пример файла .env.local для сервера reg.ru
# Скопируйте этот файл в .env.local и заполните своими значениями

# База данных (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# JWT секрет (сгенерируйте свой уникальный ключ)
# Можно сгенерировать: openssl rand -base64 32
JWT_SECRET="9JIrDqLHlKvg3CwYIQJa5lKmRoAp1khQlU7fInuPjp3"

# Администратор по умолчанию
MASTER_ADMIN_EMAIL="admin@227.info"
MASTER_ADMIN_PASSWORD="admin123"

# S3 хранилище (Reg.ru)
# Получите ключи в панели Reg.ru → Хранилище S3 → tashi-ani-base → Ключи доступа
AWS_ACCESS_KEY_ID="ваш_access_key_id_здесь"
AWS_SECRET_ACCESS_KEY="ваш_secret_access_key_здесь"

# Настройки приложения
NODE_ENV="production"
PORT=3000

# Опционально: Email настройки (если используете отправку email)
# EMAIL_HOST="smtp.reg.ru"
# EMAIL_PORT=587
# EMAIL_USER="your-email@yourdomain.ru"
# EMAIL_PASS="your-email-password"
# EMAIL_FROM="noreply@yourdomain.ru"
